<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Только debug: testOnly позволяет снять Device Owner командой `dpm remove-active-admin` без сброса устройства.
        В release этого атрибута нет — снять DO с боевого планшета без сброса нельзя.
    -->
    <!--
        Только debug: доверие к CA стенда (APK-хост, брокер). Файл xml/network_security_config генерируется в
        build/generated/ задачей generate<Variant>StandTrust; в release атрибута нет (проверяет verifyReleaseNoDebugSurface).
    -->
    <application
        android:networkSecurityConfig="@xml/network_security_config"
        android:testOnly="true">

        <!--
            Только debug: учётка брокера (DEV_CONFIG) или код регистрации (DEV_PROVISION) приходят командой adb
            (`am broadcast -a ru.restofleet.agent.DEV_CONFIG ...`).
            Экспортирован, но защищён разрешением DUMP: его держит только оболочка adb, обычные приложения — нет.
            В release ресивера нет (проверяет verifyReleaseNoDebugSurface). В MVP-B учётку заменит QR (D7).
        -->
        <receiver
            android:name=".DevConfigReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="ru.restofleet.agent.DEV_CONFIG" />
                <!-- Регистрация по одноразовому коду (код + baseUrl), как в мастере: автоматизация S1 (план 3.5) -->
                <action android:name="ru.restofleet.agent.DEV_PROVISION" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
