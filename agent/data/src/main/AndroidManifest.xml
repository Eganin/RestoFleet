<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- P1–P3: HTTPS-пробы и проба шлюза -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- R5: SSID доступен только при разрешении на геолокацию -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- R8: выдаётся пользователем через «Доступ к данным об использовании» -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- R13: Build.getSerial() (адаптер Device Owner выдаёт разрешение сам себе; объявлено, иначе выдавать нечего) -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />

    <!-- R7/R12: видимость пакетов на Android 11+ (реш. 425): отслеживаемые приложения задаёт тень или сборка
         (rf.watchedApps), поэтому видны все приложения с лаунчером, без QUERY_ALL_PACKAGES; D4: пакет lock task тоже
         приходит в команде (иначе getPackageInfo бросит NameNotFoundException) -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>
</manifest>
