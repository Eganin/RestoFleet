<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- P1–P3: HTTPS-пробы и проба шлюза -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- R5: SSID доступен только при разрешении на геолокацию -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- R8: выдаётся пользователем через «Доступ к данным об использовании» -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- R13: Build.getSerial() (адаптер Device Owner выдаёт разрешение сам себе; объявлено, иначе выдавать нечего) -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />

    <!-- R7/R12: видимость пакетов на Android 11+; D4: пакет для lock task приходит в команде, поэтому видны все
         приложения с лаунчером (иначе getPackageInfo для них бросит NameNotFoundException) -->
    <queries>
        <package android:name="com.android.chrome" />
        <package android:name="ru.restofleet.dummy.waiter" />
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>
</manifest>
