# Скопировать в deploy/.env (в .gitignore) — это делает ./prepare-stand.sh — и заменить значения.
# Пароль администратора Dynamic Security: openssl rand -base64 32
DYNSEC_ADMIN_PASSWORD=change-me

# --- Бэкенд (КМ2b). Секретов здесь нет: пароли БД и backend MQTT, секрет JWT, пароль admin — файлы deploy/out/*
# (600), их монтирует compose `secrets` в /run/secrets (реш. 252). Ниже — только параметры стенда.

# Адрес брокера в ответе /provision: эмулятор — 10.0.2.2, реальное устройство — IP машины в LAN (он же в SAN)
RF_PROVISIONING_BROKERHOST=10.0.2.2
RF_PROVISIONING_BROKERPORT=8883
# Rate limit на IP клиента в минуту (реш. 249). Симулятор КМ4 регистрирует тысячи устройств — поднять provision
RF_RATELIMIT_LOGINPERMINUTE=10
RF_RATELIMIT_PROVISIONPERMINUTE=60
# REST-polling: устройство offline без опроса дольше этого (3 × интервал опроса, реш. 214)
RF_POLLING_STALEAFTERMS=90000
